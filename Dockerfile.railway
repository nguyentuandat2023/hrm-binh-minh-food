# Image cho Railway (tự triển khai từ GitHub).
# Khác Dockerfile chính: giữ Prisma CLI + tsx để mỗi lần khởi động tự chạy migration và dữ liệu nền
# (Railway không có bước "migrate" riêng như docker-compose).
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate && npx next build && cp -r .next/static .next/standalone/.next/static && mkdir -p /app/storage
ENV NODE_ENV=production HOSTNAME=0.0.0.0 STORAGE_DIR=/app/storage
EXPOSE 3000
# scripts/railway-start.mjs: kiểm tra cấu hình → chờ DB → migrate → dữ liệu nền + quản trị đầu tiên → chạy ứng dụng.
# Cấu hình sai thì mở trang hướng dẫn tiếng Việt thay vì khởi động lại liên tục.
CMD ["node", "scripts/railway-start.mjs"]
