# ===== Biến môi trường PRODUCTION (Docker Compose) =====
# Sao chép thành .env, thay toàn bộ giá trị CHANGE_ME. Không commit file .env.
# Sinh chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

POSTGRES_USER=hrm
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=hrm

# 32 byte base64 – SAO LƯU RIÊNG, mất khoá = mất dữ liệu đã mã hoá (CCCD, số tài khoản, TOTP)
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
CRON_SECRET=CHANGE_ME_RANDOM
QR_SECRET=CHANGE_ME_RANDOM

# Tên miền thật (Caddy tự cấp HTTPS cho DOMAIN; APP_URL dùng kiểm tra Origin chống CSRF và link QR)
DOMAIN=hrm.congty.vn
APP_URL=https://hrm.congty.vn
COOKIE_SECURE=true
SESSION_TTL_HOURS=12

# Chỉ bật trên đúng 1 instance; nhiều instance → tắt và dùng cron gọi /api/cron/daily
ENABLE_INTERNAL_SCHEDULER=true
