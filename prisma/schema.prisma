// =============================================================
// HRM – Cơ sở dữ liệu nhân sự (PostgreSQL + Prisma)
// Quy ước: tiền tệ lưu bằng số nguyên VND (Int); ngày công lưu kiểu DATE;
// mốc thời gian lưu UTC (timestamptz), hiển thị theo Asia/Ho_Chi_Minh.
// Dữ liệu nhạy cảm (CCCD, số tài khoản, TOTP secret) được mã hoá AES-256-GCM
// ở tầng ứng dụng (cột *Enc), kèm cột *Hash (HMAC) để chống trùng lặp.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------- Enums ----------------------------

enum DataScope {
  SELF
  TEAM
  DEPARTMENT
  BRANCH
  COMPANY
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  SEASONAL
  CONTRACTOR
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  LEAVE_OF_ABSENCE
  RESIGNED
}

enum ContractType {
  PROBATION
  FIXED_TERM
  INDEFINITE
  SERVICE
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum PayType {
  MONTHLY
  DAILY
  HOURLY
}

enum DocumentCategory {
  AVATAR
  CV
  ID_CARD
  CONTRACT
  CERTIFICATE
  LEAVE_ATTACHMENT
  OTHER
}

enum CheckMethod {
  WEB
  QR
  GPS
  MANUAL
  ADJUSTMENT
}

enum HalfDay {
  NONE
  MORNING
  AFTERNOON
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalType {
  LEAVE
  ATTENDANCE_ADJUSTMENT
  OVERTIME
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollConfigStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  APPROVED
  LOCKED
}

enum PayrollAdjustmentType {
  BONUS
  COMMISSION
  ALLOWANCE
  DEDUCTION
  ADVANCE
}

enum KpiCategory {
  SALES
  TASK
  QUALITY
  PROGRESS
  PERSONAL
}

enum KpiDirection {
  HIGHER_BETTER
  LOWER_BETTER
}

enum KpiStatus {
  OPEN
  SUBMITTED
  REVIEWED
  CLOSED
}

enum JobStatus {
  DRAFT
  OPEN
  ON_HOLD
  CLOSED
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewResult {
  PENDING
  PASS
  FAIL
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

enum ChecklistStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssetCategory {
  LAPTOP
  PHONE
  OFFICE_EQUIPMENT
  TOOL
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  RETIRED
}

// ---------------------- Tài khoản & phân quyền ----------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  totpSecretEnc      String?
  totpEnabled        Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles         UserRole[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // ví dụ: employee.view
  module      String
  action      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  scope        DataScope  @default(SELF)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaVerified Boolean   @default(false)
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
  @@map("sessions")
}

// ---------------------- Tổ chức ----------------------

model Branch {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  gpsRadiusM   Int          @default(200)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  departments  Department[]
  employees    Employee[]
  assets       Asset[]
  jobs         RecruitmentJob[]

  @@map("branches")
}

model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  parentId    String?
  parent      Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DeptTree")
  branchId    String?
  branch      Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  headId      String?      @unique
  head        Employee?    @relation("DeptHead", fields: [headId], references: [id], onDelete: SetNull)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  employees   Employee[]   @relation("DeptMembers")
  positions   Position[]
  kpiAssignments KpiAssignment[]
  jobs        RecruitmentJob[]

  @@index([parentId])
  @@map("departments")
}

model Position {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  level        Int         @default(1)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  employees    Employee[]
  jobs         RecruitmentJob[]

  @@map("positions")
}

// ---------------------- Nhân viên ----------------------

model Employee {
  id                String          @id @default(cuid())
  code              String          @unique
  fullName          String
  avatarFileId      String?
  dateOfBirth       DateTime?       @db.Date
  gender            Gender          @default(UNDISCLOSED)
  phone             String?
  email             String?         @unique
  address           String?
  nationalIdEnc     String?
  nationalIdHash    String?         @unique
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  departmentId      String?
  department        Department?     @relation("DeptMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  positionId        String?
  position          Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)
  managerId         String?
  manager           Employee?       @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]      @relation("Manager")
  branchId          String?
  branch            Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  startDate         DateTime        @db.Date
  employmentType    EmploymentType  @default(FULL_TIME)
  status            EmployeeStatus  @default(PROBATION)
  probationEndDate  DateTime?       @db.Date
  endDate           DateTime?       @db.Date
  deactivatedAt     DateTime?
  searchText        String          @default("") // tên/mã/email/SĐT không dấu, chữ thường – phục vụ tìm kiếm tiếng Việt
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User?
  headOf            Department?     @relation("DeptHead")
  contracts         EmploymentContract[]
  documents         EmployeeDocument[]
  salaryProfile     SalaryProfile?
  allowances        EmployeeAllowance[]
  salaryAdjustments SalaryAdjustment[]
  shiftAssignments  ShiftAssignment[]
  attendance        AttendanceRecord[]
  adjustments       AttendanceAdjustment[]
  overtime          OvertimeRequest[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  approvals         ApprovalRequest[]
  payrollRecords    PayrollRecord[]
  payrollAdjustments PayrollAdjustment[]
  kpiAssignments    KpiAssignment[]
  checklists        LifecycleChecklist[] @relation("ChecklistEmployee")
  mentoring         LifecycleChecklist[] @relation("ChecklistMentor")
  lifecycleTasks    LifecycleTask[]
  assetAssignments  AssetAssignment[]
  assetsInUse       Asset[]
  hiredFrom         Candidate?

  @@index([departmentId])
  @@index([branchId])
  @@index([managerId])
  @@index([status])
  @@index([fullName])
  @@map("employees")
}

model EmploymentContract {
  id               String              @id @default(cuid())
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  code             String              @unique
  type             ContractType
  status           ContractStatus      @default(ACTIVE)
  signedDate       DateTime?           @db.Date
  startDate        DateTime            @db.Date
  endDate          DateTime?           @db.Date
  baseSalary       Int?
  documentId       String?
  previousId       String?             @unique
  previous         EmploymentContract? @relation("Renewal", fields: [previousId], references: [id], onDelete: SetNull)
  renewal          EmploymentContract? @relation("Renewal")
  note             String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([employeeId])
  @@index([endDate])
  @@map("employment_contracts")
}

model EmployeeDocument {
  id           String           @id @default(cuid())
  employeeId   String?
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category     DocumentCategory @default(OTHER)
  fileName     String
  storedName   String           @unique
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?

  @@index([employeeId])
  @@map("employee_documents")
}

model SalaryProfile {
  employeeId      String   @id
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payType         PayType  @default(MONTHLY)
  baseSalary      Int      @default(0)
  insuranceSalary Int?
  dependents      Int      @default(0)
  bankName        String?
  bankAccountEnc  String?
  bankAccountName String?
  updatedAt       DateTime @updatedAt

  @@map("salary_profiles")
}

model EmployeeAllowance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  amount     Int
  taxable    Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([employeeId])
  @@map("employee_allowances")
}

model SalaryAdjustment {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate DateTime @db.Date
  oldSalary     Int
  newSalary     Int
  reason        String
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@map("salary_adjustments")
}

// ---------------------- Chấm công & ca làm ----------------------

model WorkShift {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  startTime         String            // HH:mm theo giờ Việt Nam
  endTime           String            // HH:mm, nếu nhỏ hơn startTime → ca qua đêm
  breakMinutes      Int               @default(60)
  graceLateMinutes  Int               @default(5)
  graceEarlyMinutes Int               @default(5)
  workdayValue      Float             @default(1)
  color             String            @default("#0f766e")
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  assignments       ShiftAssignment[]
  records           AttendanceRecord[]

  @@map("work_shifts")
}

model ShiftAssignment {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String?   // null = ngày nghỉ (dùng cho lịch ca xoay)
  shift      WorkShift? @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  daysOfWeek Int[]     // 0=CN ... 6=T7; rỗng = theo ngày làm việc của công ty
  note       String?
  createdAt  DateTime  @default(now())

  @@index([employeeId, startDate])
  @@map("shift_assignments")
}

model AttendanceRecord {
  id              String      @id @default(cuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate        DateTime    @db.Date
  shiftId         String?
  shift           WorkShift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  checkInMethod   CheckMethod?
  checkOutMethod  CheckMethod?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  lateMinutes     Int         @default(0)
  earlyMinutes    Int         @default(0)
  workedMinutes   Int         @default(0)
  workdayValue    Float       @default(0)
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_records")
}

model AttendanceAdjustment {
  id                String        @id @default(cuid())
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate          DateTime      @db.Date
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            RequestStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  decidedAt         DateTime?

  @@index([employeeId, workDate])
  @@map("attendance_adjustments")
}

model OvertimeRequest {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate        DateTime      @db.Date
  startAt         DateTime
  endAt           DateTime
  minutes         Int
  dayKind         String        @default("WEEKDAY") // WEEKDAY | WEEKEND | HOLIDAY
  reason          String
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  decidedAt       DateTime?

  @@index([employeeId, workDate])
  @@map("overtime_requests")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  isPaid    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("holidays")
}

// ---------------------- Nghỉ phép ----------------------

model LeaveType {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  isPaid             Boolean        @default(true)
  deductsBalance     Boolean        @default(true)
  defaultQuota       Float          @default(0)
  requiresAttachment Boolean        @default(false)
  color              String         @default("#2563eb")
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  requests           LeaveRequest[]
  balances           LeaveBalance[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  entitled    Float     @default(0)
  carriedOver Float     @default(0)
  adjustment  Float     @default(0)
  used        Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  halfDay      HalfDay       @default(NONE)
  days         Float
  reason       String
  attachmentId String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  decidedAt    DateTime?

  @@index([employeeId, startDate])
  @@index([status])
  @@map("leave_requests")
}

// ---------------------- Phê duyệt (dùng chung) ----------------------

model ApprovalRequest {
  id              String           @id @default(cuid())
  type            ApprovalType
  entityId        String
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requesterUserId String?
  title           String
  status          RequestStatus    @default(PENDING)
  currentLevel    Int              @default(1)
  requiredLevels  Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  decidedAt       DateTime?
  steps           ApprovalStep[]

  @@unique([type, entityId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id          String           @id @default(cuid())
  requestId   String
  request     ApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level       Int
  actorUserId String
  decision    ApprovalDecision
  comment     String?
  createdAt   DateTime         @default(now())

  @@index([requestId])
  @@map("approval_steps")
}

// ---------------------- Tiền lương ----------------------

model PayrollConfig {
  id            String              @id @default(cuid())
  version       Int                 @unique
  name          String
  status        PayrollConfigStatus @default(DRAFT)
  effectiveFrom DateTime            @db.Date
  params        Json
  verifiedNote  String?
  verifiedById  String?
  verifiedAt    DateTime?
  createdById   String?
  createdAt     DateTime            @default(now())
  periods       PayrollPeriod[]

  @@map("payroll_configs")
}

model PayrollPeriod {
  id               String              @id @default(cuid())
  code             String              @unique // YYYY-MM
  name             String
  year             Int
  month            Int
  startDate        DateTime            @db.Date
  endDate          DateTime            @db.Date
  standardWorkdays Float
  status           PayrollPeriodStatus @default(DRAFT)
  configId         String?
  config           PayrollConfig?      @relation(fields: [configId], references: [id], onDelete: Restrict)
  calculatedAt     DateTime?
  calculatedById   String?
  approvedById     String?
  approvedAt       DateTime?
  lockedById       String?
  lockedAt         DateTime?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  records          PayrollRecord[]
  adjustments      PayrollAdjustment[]

  @@map("payroll_periods")
}

model PayrollRecord {
  id                String        @id @default(cuid())
  periodId          String
  period            PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payType           PayType
  baseSalary        Int
  standardWorkdays  Float
  actualWorkdays    Float
  paidLeaveDays     Float
  holidayDays       Float
  unpaidLeaveDays   Float
  workedHours       Float
  overtimeHours     Float
  grossIncome       Int
  taxableIncome     Int
  insuranceEmployee Int
  insuranceEmployer Int
  pit               Int
  totalDeductions   Int
  netPay            Int
  breakdown         Json
  createdAt         DateTime      @default(now())
  items             PayrollItem[]

  @@unique([periodId, employeeId])
  @@map("payroll_records")
}

model PayrollItem {
  id       String        @id @default(cuid())
  recordId String
  record   PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  code     String
  name     String
  kind     String        // EARNING | DEDUCTION | EMPLOYER | INFO
  amount   Int
  taxable  Boolean       @default(false)
  sort     Int           @default(0)

  @@index([recordId])
  @@map("payroll_items")
}

model PayrollAdjustment {
  id          String                @id @default(cuid())
  periodId    String
  period      PayrollPeriod         @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        PayrollAdjustmentType
  amount      Int
  taxable     Boolean               @default(true)
  note        String?
  createdById String?
  createdAt   DateTime              @default(now())

  @@index([periodId, employeeId])
  @@map("payroll_adjustments")
}

// ---------------------- KPI ----------------------

model KpiDefinition {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  category    KpiCategory
  unit        String          @default("%")
  direction   KpiDirection    @default(HIGHER_BETTER)
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  assignments KpiAssignment[]

  @@map("kpi_definitions")
}

model KpiAssignment {
  id           String        @id @default(cuid())
  definitionId String
  definition   KpiDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  employeeId   String?
  employee     Employee?     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  period       String        // ví dụ 2026-11 hoặc 2026-Q4
  target       Float
  weight       Float         @default(1)
  status       KpiStatus     @default(OPEN)
  managerScore Float?
  managerNote  String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  results      KpiResult[]

  @@index([period])
  @@index([employeeId])
  @@map("kpi_assignments")
}

model KpiResult {
  id           String        @id @default(cuid())
  assignmentId String
  assignment   KpiAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  value        Float
  note         String?
  recordedById String?
  recordedAt   DateTime      @default(now())

  @@index([assignmentId])
  @@map("kpi_results")
}

// ---------------------- Tuyển dụng ----------------------

model RecruitmentJob {
  id           String         @id @default(cuid())
  code         String         @unique
  title        String
  departmentId String?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?
  position     Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  headcount    Int            @default(1)
  salaryRange  String?
  description  String?
  requirements String?
  status       JobStatus      @default(DRAFT)
  deadline     DateTime?      @db.Date
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  candidates   Candidate[]

  @@map("recruitment_jobs")
}

model Candidate {
  id              String         @id @default(cuid())
  jobId           String
  job             RecruitmentJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  fullName        String
  email           String?
  phone           String?
  source          String?
  cvFileId        String?
  stage           CandidateStage @default(APPLIED)
  rating          Int?
  notes           String?
  hiredEmployeeId String?        @unique
  hiredEmployee   Employee?      @relation(fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  interviews      Interview[]

  @@index([jobId, stage])
  @@map("candidates")
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scheduledAt   DateTime
  durationMin   Int             @default(60)
  location      String?
  interviewers  String?
  result        InterviewResult @default(PENDING)
  score         Int?
  notes         String?
  createdAt     DateTime        @default(now())

  @@index([scheduledAt])
  @@map("interviews")
}

// ---------------------- Tiếp nhận / nghỉ việc ----------------------

model LifecycleChecklist {
  id          String          @id @default(cuid())
  type        ChecklistType
  employeeId  String
  employee    Employee        @relation("ChecklistEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  mentorId    String?
  mentor      Employee?       @relation("ChecklistMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  status      ChecklistStatus @default(IN_PROGRESS)
  targetDate  DateTime?       @db.Date
  reason      String?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  tasks       LifecycleTask[]

  @@index([employeeId])
  @@map("lifecycle_checklists")
}

model LifecycleTask {
  id          String             @id @default(cuid())
  checklistId String
  checklist   LifecycleChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  category    String             @default("OTHER")
  assigneeId  String?
  assignee    Employee?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate     DateTime?          @db.Date
  doneAt      DateTime?
  doneById    String?
  note        String?
  sort        Int                @default(0)

  @@index([checklistId])
  @@map("lifecycle_tasks")
}

// ---------------------- Tài sản ----------------------

model Asset {
  id                String            @id @default(cuid())
  code              String            @unique
  name              String
  category          AssetCategory
  serialNumber      String?
  purchaseDate      DateTime?         @db.Date
  purchaseCost      Int?
  status            AssetStatus       @default(AVAILABLE)
  condition         String?
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  currentHolderId   String?
  currentHolder     Employee?         @relation(fields: [currentHolderId], references: [id], onDelete: SetNull)
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignments       AssetAssignment[]

  @@index([status])
  @@map("assets")
}

model AssetAssignment {
  id            String    @id @default(cuid())
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedAt    DateTime  @default(now())
  returnedAt    DateTime?
  conditionOut  String?
  conditionIn   String?
  assignedById  String?
  receivedById  String?
  note          String?

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

// ---------------------- Thông báo, nhật ký, cấu hình ----------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // LOGIN, LOGIN_FAILED, CREATE, UPDATE, DEACTIVATE, APPROVE, REJECT, EXPORT, ...
  entityType String?
  entityId   String?
  summary    String?
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model CompanySetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("company_settings")
}

model Sequence {
  name  String @id
  value Int    @default(0)

  @@map("sequences")
}
