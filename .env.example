# =============================================================
# HRM – Biến môi trường mẫu. KHÔNG commit file .env thật.
# Chạy `node scripts/setup-env.mjs` để tạo .env với bí mật ngẫu nhiên.
# =============================================================

# Kết nối PostgreSQL
DATABASE_URL="postgresql://hrm:CHANGE_ME@localhost:5433/hrm?schema=public"

# Khoá mã hoá dữ liệu nhạy cảm (CCCD, số tài khoản, TOTP) – 32 byte base64.
# Mất khoá = không giải mã được dữ liệu đã mã hoá. Phải sao lưu khoá tách biệt với DB.
DATA_ENCRYPTION_KEY="CHANGE_ME_BASE64_32_BYTES"

# Bí mật dùng cho job tự động gọi qua HTTP (header x-cron-secret)
CRON_SECRET="CHANGE_ME"

# Bí mật ký mã QR chấm công
QR_SECRET="CHANGE_ME"

# Địa chỉ gốc của ứng dụng (dùng kiểm tra Origin chống CSRF và tạo link QR)
APP_URL="http://localhost:3000"

# Thư mục lưu file tải lên (ngoài thư mục public, chỉ phục vụ qua API có kiểm tra quyền)
STORAGE_DIR="./storage"

# Thư mục chứa bản sao lưu
BACKUP_DIR="./backups"

# Bật bộ lập lịch nội bộ (thông báo hợp đồng, sinh nhật, thiếu chấm công) – chỉ bật trên 1 instance
ENABLE_INTERNAL_SCHEDULER="true"

# Cookie Secure (bắt buộc "true" khi chạy HTTPS ở production)
COOKIE_SECURE="false"

# Thời hạn phiên đăng nhập (giờ)
SESSION_TTL_HOURS="12"
